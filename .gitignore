# Large local data files
# Keep folders, but avoid committing downloaded datasets unless intentionally needed.
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Output exports
outputs/charts/*
outputs/maps/*
outputs/reports/*
!outputs/charts/.gitkeep
!outputs/maps/.gitkeep
!outputs/reports/.gitkeep
